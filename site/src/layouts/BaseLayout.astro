---
import Header from '../components/Header.astro';
import SEOHead from '../components/SEOHead.astro';
import CodeBlockEnhancer from '../components/CodeBlockEnhancer.astro';
import Mermaid from '../components/Mermaid.astro';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonicalUrl?: string;
  robots?: string;
  ogType?: string;
  publishedDate?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown>;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YQJXC9G6B4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-YQJXC9G6B4');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#0d0d0f" />
    <meta name="theme-color" content="#0d0d0f" />
    <meta name="generator" content={Astro.generator} />
    <SEOHead {...props} />
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <footer class="container footer">
      <a class="footer-name" href="/about/">Stepan Zolotukhin</a>
      <nav aria-label="Footer">
        <a href="/topics/">Topics</a>
        <a href="/feed.xml">RSS</a>
        <a href="https://github.com/zolotukhin">GitHub</a>
        <a href="https://x.com/zolotukhin_ai">X</a>
        <a href="/about/">Contact</a>
      </nav>
    </footer>
    <CodeBlockEnhancer />
    <Mermaid />
  </body>
</html>

<style>
  main {
    padding: var(--space-xl) var(--space-md);
    min-height: calc(100vh - 200px);
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    max-width: var(--max-width-wide);
    border-top: 1px solid var(--color-border);
    padding: var(--space-lg) var(--space-md);
    font-size: 0.74rem;
    color: var(--color-text-muted);
  }
  .footer-name { color: var(--color-text-muted); }
  .footer nav { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; }
</style>
