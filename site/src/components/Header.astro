---
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/zinc/', label: 'ZINC' },
  { href: '/zinc/docs/', label: 'Docs' },
  { href: '/zinc/benchmarks/', label: 'Benchmarks' },
  { href: '/blog/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => href === '/zinc/'
  ? pathname === href
  : pathname === href || pathname.startsWith(href);
---

<header class="site-header">
  <nav class="container nav" aria-label="Main navigation">
    <a href="/" class="site-name">zolotukhin.ai</a>
    <button class="nav-toggle" type="button" aria-controls="site-nav-links" aria-expanded="false">Menu</button>
    <ul id="site-nav-links" class="nav-links">
      {navItems.map(item => (
        <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = header?.querySelector<HTMLUListElement>('.nav-links');
  if (header && toggle && links) {
    header.dataset.enhanced = 'true';
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      links.classList.remove('is-open');
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      links.classList.toggle('is-open', open);
    });
    header.addEventListener('keydown', event => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
        toggle.focus();
      }
    });
    links.addEventListener('click', event => {
      if ((event.target as Element).closest('a')) close();
    });
    window.matchMedia('(min-width: 821px)').addEventListener('change', close);
  }
</script>

<style>
  .site-header { border-bottom: 1px solid var(--color-border); padding: 1rem 0; }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; max-width: var(--max-width-wide); }
  .site-name { color: var(--color-text); font-size: 1.05rem; font-weight: 700; letter-spacing: -0.02em; text-decoration: none; }
  .nav-links { display: flex; align-items: center; gap: 1.5rem; list-style: none; padding: 0; margin: 0; }
  .nav-links li { margin: 0; }
  .nav-links a { display: block; padding: 0.25rem 0; color: var(--color-text-muted); font-size: 0.8rem; }
  .nav-links a:hover, .nav-links a[aria-current] { color: var(--color-text); text-decoration: none; }
  .nav-links a[aria-current] { text-decoration: underline; text-underline-offset: 0.35em; text-decoration-color: var(--color-accent); }
  .nav-toggle { display: none; padding: 0.5rem 0.75rem; min-height: 44px; border: 1px solid var(--color-border); border-radius: 5px; color: var(--color-text); background: var(--color-bg); font: inherit; font-size: 0.8rem; cursor: pointer; }
  @media (max-width: 820px) {
    .site-header { padding: 0.6rem 0; }
    .nav { gap: 0; }
    .nav-links { flex-direction: column; align-items: stretch; gap: 0; width: 100%; padding-top: 0.6rem; }
    .nav-links a { padding: 0.65rem 0; }
    .site-header[data-enhanced] .nav-toggle { display: block; }
    .site-header[data-enhanced] .nav-links:not(.is-open) { display: none; }
  }
</style>
